{
  "name": "ls-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "browser:open": "node scripts/crm-browser.cjs open",
    "browser:save": "node scripts/crm-browser.cjs save",
    "browser:status": "node scripts/crm-browser.cjs status",
    "test:browser": "playwright test",
    "test:browser:connection": "playwright test connection.spec.ts",
    "test:browser:headed": "playwright test --headed",
    "test:browser:report": "playwright show-report",
    "test:crm:existing": "playwright test --config playwright.crm-existing.config.ts baseline.spec.ts",
    "test:crm:release": "playwright test --config playwright.crm-existing.config.ts release.spec.ts --output test-results/crm-release-gates --reporter=list",
    "test:crm": "node --require ./tests/register.cjs --test tests/crm.test.cjs tests/work-history-format.test.cjs tests/crm-extensions.test.cjs tests/module-navigation.test.cjs tests/platform-proxy.test.cjs tests/access-policy.test.cjs",
    "test:crm:integration": "node --require ./tests/register.cjs --test tests/crm.integration.test.cjs",
    "test:crm:scopes:integration": "node --require ./tests/register.cjs --test --test-force-exit tests/crm-record-scopes.integration.test.cjs tests/crm-record-scope-migration.test.cjs",
    "test:crm:teams:integration": "node --require ./tests/register.cjs --test tests/crm-teams.integration.test.cjs",
    "test:crm:fields:integration": "node --require ./tests/register.cjs --test tests/custom-fields.integration.test.cjs",
    "test:crm:sales:integration": "node --require ./tests/register.cjs --test tests/crm-sales.integration.test.cjs",
    "test:real-estate:integration": "node --require ./tests/register.cjs --test tests/real-estate.integration.test.cjs",
    "test:audit:integration": "node --require ./tests/register.cjs --test --test-concurrency=1 --test-force-exit tests/audit-review.integration.test.cjs tests/audit-index-migration.test.cjs tests/audit-format.test.cjs",
    "test:core:integration": "node --require ./tests/register.cjs --test --test-force-exit tests/core-access.integration.test.cjs tests/users.integration.test.cjs tests/settings-work.integration.test.cjs tests/dashboard.integration.test.cjs",
    "test:workforce:integration": "node --require ./tests/register.cjs --test --test-force-exit tests/workforce-access.integration.test.cjs tests/workforce-module-migration.test.cjs",
    "test:appointments:integration": "node --require ./tests/register.cjs --test --test-force-exit tests/appointments-access.integration.test.cjs tests/appointments-module-migration.test.cjs",
    "test:services:integration": "node --require ./tests/register.cjs --test --test-force-exit tests/services-access.integration.test.cjs tests/services-module-migration.test.cjs",
    "test:inventory:integration": "node --require ./tests/register.cjs --test --test-force-exit tests/inventory-access.integration.test.cjs tests/inventory-module-migration.test.cjs",
    "test:modules:integration": "node --require ./tests/register.cjs --test tests/module-access.integration.test.cjs tests/module-allowance-migration.test.cjs",
    "test:tenants:integration": "node --require ./tests/register.cjs --test tests/tenant-provisioning.integration.test.cjs",
    "test:dashboard:integration": "node --require ./tests/register.cjs --test tests/dashboard.integration.test.cjs",
    "test:settings-work:integration": "node --require ./tests/register.cjs --test tests/settings-work.integration.test.cjs",
    "test:tenant-pool:integration": "node --require ./tests/register.cjs --test tests/tenant-pool.integration.test.cjs",
    "test:users:integration": "node --require ./tests/register.cjs --test tests/users.integration.test.cjs",
    "test:crm:migration": "node -r dotenv/config --test tests/crm.migration.test.cjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "test:crm:quotations": "node --require ./tests/register.cjs --test tests/quotation-calculation.test.cjs",
    "test:crm:quotations:integration": "node --require ./tests/register.cjs --test --test-force-exit tests/quotations.integration.test.cjs",
    "test:access:integration": "node --require ./tests/register.cjs --test --test-force-exit tests/access-roles.integration.test.cjs tests/access-role-migration.test.cjs",
    "test:access:e2e": "playwright test --config playwright.local-access.config.ts access.spec.ts",
    "test:workflows:e2e": "playwright test --config playwright.local-access.config.ts",
    "test:dates": "node --require ./tests/register.cjs --test tests/date-display.test.cjs tests/work-history-format.test.cjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^6.19.2",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@syncfusion/ej2-react-schedule": "^29.2.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.4",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.12",
    "pdf-lib": "^1.17.1",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
